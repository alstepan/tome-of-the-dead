# Build artifacts
/build/*
!/build/.gitkeep

# sjasmplus listings / debug output kept out of git
*.lst
*.sld
*.map
*.exp

# Emulator state
*.szx
*.z80.snap
*.rzx

# Generated graphics intermediates (sources live in assets/, packed asm is committed)
*.intermediate.png
# Render-backs from gfx_assess (reproducible from the packed .asm)
*_render.png

# Python (test harness / tools)
__pycache__/
*.pyc

# macOS
.DS_Store

# Agent worktrees (isolated checkouts)
/.claude/worktrees/
/tools/bin/

# Rendered audio (regenerate: python3 -I tools/tsx_render.py)
/assets/sfx/music/renders/*.wav
